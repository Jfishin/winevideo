+HRESULT d3d9_dxmt_video_surface_upload(
+        struct d3d9_dxmt_video_surface *surface,
+        const void *pixels, UINT row_pitch)
+{
+    HRESULT hr;
+    ULONGLONG deadline;
+    BOOL complete;
+
+    ID3D11DeviceContext_UpdateSubresource(surface->context,
+            (ID3D11Resource *)surface->texture, 0, NULL, pixels,
+            row_pitch, 0);
+    ID3D11DeviceContext_End(surface->context,
+            (ID3D11Asynchronous *)surface->completion_query);
+    ID3D11DeviceContext_Flush(surface->context);
+    ++surface->upload_count;
+
+    deadline = GetTickCount64() + 1000;
+    do
+    {
+        complete = FALSE;
+        hr = ID3D11DeviceContext_GetData(surface->context,
+                (ID3D11Asynchronous *)surface->completion_query,
+                &complete, sizeof(complete),
+                D3D11_ASYNC_GETDATA_DONOTFLUSH);
+        if (FAILED(hr) || GetTickCount64() >= deadline)
+            break;
+        if (hr != S_OK || !complete)
+            SwitchToThread();
+    } while (hr != S_OK || !complete);
+
+    if (hr != S_OK || !complete)
+    {
+        if (SUCCEEDED(hr))
+            hr = DXGI_ERROR_WAS_STILL_DRAWING;
+        if (!surface->upload_failure_logged)
+        {
+            WARN("d3d9-video-bridge: upload completion failed after %u frame(s), hr %#lx.\n",
+                    surface->upload_count, hr);
+            surface->upload_failure_logged = TRUE;
+        }
+        return hr;
+    }
+
+    if (FAILED(hr = ID3D11Device_GetDeviceRemovedReason(surface->device)))
+    {
+        if (!surface->upload_failure_logged)
+        {
+            WARN("d3d9-video-bridge: upload failed after %u frame(s), hr %#lx.\n",
+                    surface->upload_count, hr);
+            surface->upload_failure_logged = TRUE;
+        }
+        return hr;
+    }
+
+    TRACE("d3d9-video-bridge: uploaded frame %u with pitch %u.\n",
+            surface->upload_count, row_pitch);
+    return S_OK;
+}
